<Project>
  <PropertyGroup>
    <!-- A pinned pack revision makes source-control manager discovery unnecessary and origin-dependent. -->
    <EnableSourceControlManagerQueries
      Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">false</EnableSourceControlManagerQueries>
    <_RepositorySourceRoot
      Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_RepositorySourceRoot>
    <!-- Keep compiler document paths stable even when the source tree is reached through a filesystem alias. -->
    <PathMap Condition="('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '') and '$(OS)' == 'Windows_NT'">$(_RepositorySourceRoot)=/_/</PathMap>
    <PathMap Condition="('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '') and '$(OS)' != 'Windows_NT'">$(_RepositorySourceRoot)=/_/;/var/=/_/;/private/var/=/_/</PathMap>
  </PropertyGroup>

  <Target Name="NormalizeGeneratedSourceLineEndings"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.g.cs" />
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.AssemblyInfo.cs" />
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.AssemblyAttributes.cs" />
    </ItemGroup>

    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts/Normalize-GeneratedSources.ps1&quot; -Path &quot;%(_GeneratedSourceFile.Identity)&quot;" />
  </Target>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>KeelMatrix</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>refs/heads/main</RepositoryBranch>
    <!-- Pack identity is supplied explicitly by the repository's pack paths. Do not inspect a clone's remote: it may be
         a local path, file URI, absent, or unavailable in a source tree without .git. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <Target Name="PinSourceControlInformation"
          BeforeTargets="InitializeSourceControlInformation;TranslateGitHubUrlsInSourceControlInformation"
          Condition="'$(IsPackable)' == 'true' and ('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '')">
    <PropertyGroup>
      <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
      <PrivateRepositoryUrl>$(RepositoryUrl)</PrivateRepositoryUrl>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">$(RepositoryCommit)</SourceRevisionId>
      <_HasGitSourceRoot Condition="'@(SourceRoot-&gt;WithMetadataValue('SourceControl', 'git'))' != ''">true</_HasGitSourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <SourceRoot Update="@(SourceRoot)" Condition="'%(SourceRoot.SourceControl)' == 'git'">
        <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <RevisionId>$(SourceRevisionId)</RevisionId>
      </SourceRoot>
      <SourceRoot Include="$(_RepositorySourceRoot)" Condition="'$(_HasGitSourceRoot)' != 'true'">
        <SourceControl>git</SourceControl>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
        <RevisionId>$(SourceRevisionId)</RevisionId>
      </SourceRoot>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Link="LICENSE" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Link="icon.png" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>

  <Target Name="ExcludeSensitiveFilesFromPack"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <None Remove="keelmatrix.telemetry.json" />
      <None Remove=".env" />
      <None Remove=".env.local" />
      <Content Remove="keelmatrix.telemetry.json" />
      <Content Remove=".env" />
      <Content Remove=".env.local" />
    </ItemGroup>
  </Target>

  <Target Name="RejectSensitiveFilesInPack"
          AfterTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_SensitivePackageFile Include="@(_PackageFiles)"
                             Condition="'%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == 'keelmatrix.telemetry.json' Or '%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == '.env' Or '%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == '.env.local'" />
    </ItemGroup>
    <Error Condition="'@(_SensitivePackageFile)' != ''"
           Text="Refusing to pack sensitive file(s): @(_SensitivePackageFile, ', ')." />
  </Target>
</Project>
