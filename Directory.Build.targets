<Project>
  <PropertyGroup>
    <!-- The strict pack revision is the caller-supplied package identity; discovery, when possible, is only
         from the packed source root's own checkout and never from a clone's origin or Git environment. -->
    <EnableSourceControlManagerQueries
      Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">false</EnableSourceControlManagerQueries>
    <_RepositorySourceRoot
      Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_RepositorySourceRoot>
    <!-- Keep compiler document paths stable even when the source tree is reached through a filesystem alias. -->
    <_RepositorySourceRootAlias
      Condition="'$(OS)' != 'Windows_NT' and $([System.String]::Copy('$(_RepositorySourceRoot)').StartsWith('/private/var/'))">$([System.String]::Copy('$(_RepositorySourceRoot)').Replace('/private/var/', '/var/'))</_RepositorySourceRootAlias>
    <_RepositorySourceRootAlias
      Condition="'$(OS)' != 'Windows_NT' and $([System.String]::Copy('$(_RepositorySourceRoot)').StartsWith('/var/'))">/private$(_RepositorySourceRoot)</_RepositorySourceRootAlias>
    <PathMap Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">$(_RepositorySourceRoot)=/_/</PathMap>
    <PathMap Condition="('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '') and '$(_RepositorySourceRootAlias)' != ''">$(_RepositorySourceRoot)=/_/,$(_RepositorySourceRootAlias)=/_/</PathMap>
  </PropertyGroup>

  <Target Name="NormalizeGeneratedSourceLineEndings"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.g.cs" />
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.AssemblyInfo.cs" />
      <_GeneratedSourceFile Include="$(IntermediateOutputPath)**\*.AssemblyAttributes.cs" />
    </ItemGroup>

    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts/Normalize-GeneratedSources.ps1&quot; -Path &quot;%(_GeneratedSourceFile.Identity)&quot;" />
  </Target>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>KeelMatrix</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>refs/heads/main</RepositoryBranch>
    <!-- Pack identity is supplied explicitly by the repository's pack paths. Do not inspect a clone's remote: it may be
         a local path, file URI, absent, or unavailable in a source tree without .git. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <BeforePack Condition="'$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != ''">ValidateExplicitPackRevision;$(BeforePack)</BeforePack>
  </PropertyGroup>

  <Target Name="ValidateExplicitPackRevision"
          Condition="'$(IsPackable)' == 'true' and ('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '')">
    <!-- A source-root .git directory or gitdir pointer is ground truth when it is available. A genuinely Git-less
         tree intentionally keeps the caller-supplied revision as the declared source of truth. Git discovery is
         scoped to this source root and all Git environment overrides are cleared for the probe. -->
    <PropertyGroup>
      <_RepositoryGitSourceRoot>$([System.IO.Path]::TrimEndingDirectorySeparator('$(_RepositorySourceRoot)'))</_RepositoryGitSourceRoot>
      <_HasRepositoryGitMetadata Condition="Exists('$(_RepositoryGitSourceRoot)/.git')">true</_HasRepositoryGitMetadata>
    </PropertyGroup>
    <ItemGroup>
      <_PackArchiveToRemove Include="$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))" />
      <_PackArchiveToRemove Include="$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).snupkg'))" />
    </ItemGroup>
    <Exec Condition="'$(_HasRepositoryGitMetadata)' == 'true'"
          Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts/Resolve-SourceRootGitRevision.ps1&quot; -SourceRoot &quot;$(_RepositoryGitSourceRoot)&quot;"
          IgnoreExitCode="true"
          ConsoleToMsBuild="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="_GitHeadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_GitHeadOutput" />
    </Exec>
    <PropertyGroup>
      <_ExplicitPackRevision Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</_ExplicitPackRevision>
      <_ExplicitPackRevision Condition="'$(SourceRevisionId)' == ''">$(RepositoryCommit)</_ExplicitPackRevision>
      <_CheckedOutPackRevision>@(_GitHeadOutput)</_CheckedOutPackRevision>
      <_NormalizedExplicitPackRevision>$([System.String]::Copy('$(_ExplicitPackRevision)').Trim().ToLowerInvariant())</_NormalizedExplicitPackRevision>
      <_NormalizedCheckedOutPackRevision>$([System.String]::Copy('$(_CheckedOutPackRevision)').Trim().ToLowerInvariant())</_NormalizedCheckedOutPackRevision>
    </PropertyGroup>
    <Delete Files="@(_PackArchiveToRemove)"
            Condition="'$(_GitHeadExitCode)' == '0' and '$(_NormalizedCheckedOutPackRevision)' != '$(_NormalizedExplicitPackRevision)'" />
    <Error Condition="'$(_GitHeadExitCode)' == '0' and '$(_NormalizedCheckedOutPackRevision)' != '$(_NormalizedExplicitPackRevision)'"
           Text="Refusing to pack: explicit revision '$(_ExplicitPackRevision)' does not match checked-out commit '$(_CheckedOutPackRevision)' at '$(_RepositorySourceRoot)'." />
  </Target>

  <Target Name="PinSourceControlInformation"
          BeforeTargets="InitializeSourceControlInformation;TranslateGitHubUrlsInSourceControlInformation"
          Condition="'$(IsPackable)' == 'true' and ('$(SourceRevisionId)' != '' or '$(RepositoryCommit)' != '')">
    <PropertyGroup>
      <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
      <PrivateRepositoryUrl>$(RepositoryUrl)</PrivateRepositoryUrl>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">$(RepositoryCommit)</SourceRevisionId>
      <_HasGitSourceRoot Condition="'@(SourceRoot-&gt;WithMetadataValue('SourceControl', 'git'))' != ''">true</_HasGitSourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <SourceRoot Update="@(SourceRoot)" Condition="'%(SourceRoot.SourceControl)' == 'git'">
        <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <RevisionId>$(SourceRevisionId)</RevisionId>
      </SourceRoot>
      <SourceRoot Include="$(_RepositorySourceRoot)" Condition="'$(_HasGitSourceRoot)' != 'true'">
        <SourceControl>git</SourceControl>
        <RepositoryUrl>$(RepositoryUrl)</RepositoryUrl>
        <ScmRepositoryUrl>$(RepositoryUrl)</ScmRepositoryUrl>
        <RevisionId>$(SourceRevisionId)</RevisionId>
      </SourceRoot>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Link="LICENSE" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Link="icon.png" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
  </ItemGroup>

  <Target Name="ExcludeSensitiveFilesFromPack"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <None Remove="keelmatrix.telemetry.json" />
      <None Remove=".env" />
      <None Remove=".env.local" />
      <Content Remove="keelmatrix.telemetry.json" />
      <Content Remove=".env" />
      <Content Remove=".env.local" />
    </ItemGroup>
  </Target>

  <Target Name="RejectSensitiveFilesInPack"
          AfterTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_SensitivePackageFile Include="@(_PackageFiles)"
                             Condition="'%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == 'keelmatrix.telemetry.json' Or '%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == '.env' Or '%(_PackageFiles.Filename)%(_PackageFiles.Extension)' == '.env.local'" />
    </ItemGroup>
    <Error Condition="'@(_SensitivePackageFile)' != ''"
           Text="Refusing to pack sensitive file(s): @(_SensitivePackageFile, ', ')." />
  </Target>
</Project>
