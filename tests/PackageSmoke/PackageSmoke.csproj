<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>KeelMatrix.ResilienceSpec.PackageSmoke</AssemblyName>
    <RootNamespace>PackageSmoke</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      This project is deliberately not part of the solution: it consumes the built package from an isolated local
      feed instead of a project reference, so the normal repository build path never depends on a local feed.
    -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ConsumerSpoof/**/*.cs" />
    <EmbeddedResource Remove="ConsumerSpoof/**/*" />
    <None Remove="ConsumerSpoof/**/*" />
    <PackageReference Include="KeelMatrix.ResilienceSpec" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- The cold-load child process loads the authentic assembly explicitly after its spoof probe. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" ExcludeAssets="compile;runtime;build;native;contentfiles;analyzers;buildtransitive" PrivateAssets="all" />
  </ItemGroup>
</Project>
