<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AssemblyName>ResilienceSpec.Probe.Runner</AssemblyName>
    <RootNamespace>ResilienceSpec.Probe.Runner</RootNamespace>
    <!--
      CA1031: the probe deliberately reports the concrete exception type of any failed attempt.
      CA1303: probe output is diagnostic text, not localized application text.
    -->
    <NoWarn>$(NoWarn);CA1031;CA1303;CA1812;CA1852;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ResilienceSpec.Probe.Core/ResilienceSpec.Probe.Core.csproj" />
  </ItemGroup>
</Project>
